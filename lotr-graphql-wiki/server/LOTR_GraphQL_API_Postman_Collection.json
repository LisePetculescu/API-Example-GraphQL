{
  "info": {
    "_postman_id": "1c5a8e0b-ee1d-4cdf-b936-473f9028b45e",
    "name": "LOTR GraphQL API - Positive and Negative Tests",
    "description": "Postman test suite for the LOTR GraphQL API exam project. Includes positive and negative tests for queries, mutations, validation, SQL injection-like input, and XSS-like input.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "createdCharacterId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Positive - Query all characters",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query GetCharacters {\\n  characters(page: 1, limit: 10) {\\n    id\\n    name\\n    race\\n    realm\\n    shortDescription\\n  }\\n}\",\n  \"variables\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () {",
              "  pm.expect(json.errors).to.be.undefined;",
              "});",
              "pm.test(\"characters is an array\", function () {",
              "  pm.expect(json.data.characters).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Positive - Query character by ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query GetCharacter($id: ID!) {\\n  character(id: $id) {\\n    id\\n    name\\n    race\\n    biography\\n    quotes {\\n      id\\n      text\\n    }\\n  }\\n}\",\n  \"variables\": {\n    \"id\": \"1\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () {",
              "  pm.expect(json.errors).to.be.undefined;",
              "});",
              "pm.test(\"character has expected fields\", function () {",
              "  pm.expect(json.data.character).to.have.property(\"id\");",
              "  pm.expect(json.data.character).to.have.property(\"name\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Positive - Create character",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation CreateCharacter($input: CharacterInput!) {\\n  createCharacter(input: $input) {\\n    id\\n    name\\n    race\\n    shortDescription\\n  }\\n}\",\n  \"variables\": {\n    \"input\": {\n      \"name\": \"Boromir\",\n      \"race\": \"Man\",\n      \"realm\": \"Gondor\",\n      \"birthYear\": \"2978 Third Age\",\n      \"weapon\": \"Sword and shield\",\n      \"affiliation\": \"Fellowship of the Ring\",\n      \"shortDescription\": \"A warrior of Gondor and member of the Fellowship.\",\n      \"biography\": \"Boromir was the eldest son of Denethor II and travelled with the Fellowship.\",\n      \"imageUrl\": \"https://example.com/boromir.jpg\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () {",
              "  pm.expect(json.errors).to.be.undefined;",
              "});",
              "pm.test(\"created character has id\", function () {",
              "  pm.expect(json.data.createCharacter.id).to.exist;",
              "  pm.collectionVariables.set(\"createdCharacterId\", json.data.createCharacter.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Positive - Update character",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"mutation UpdateCharacter($id: ID!, $input: CharacterInput!) {\\n  updateCharacter(id: $id, input: $input) {\\n    id\\n    name\\n    race\\n    shortDescription\\n  }\\n}\",\n  \"variables\": {\n    \"id\": \"{{createdCharacterId}}\",\n    \"input\": {\n      \"name\": \"Boromir of Gondor\",\n      \"race\": \"Man\",\n      \"realm\": \"Gondor\",\n      \"birthYear\": \"2978 Third Age\",\n      \"weapon\": \"Sword, shield and horn\",\n      \"affiliation\": \"Fellowship of the Ring\",\n      \"shortDescription\": \"A brave but conflicted warrior of Gondor.\",\n      \"biography\": \"Boromir was the eldest son of Denethor II and struggled with the temptation of the Ring.\",\n      \"imageUrl\": \"https://example.com/boromir.jpg\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () {",
              "  pm.expect(json.errors).to.be.undefined;",
              "});",
              "pm.test(\"updated name is correct\", function () {",
              "  pm.expect(json.data.updateCharacter.name).to.eql(\"Boromir of Gondor\");",
              "});"
            ]
          }
        }
      ]
    },
    {
