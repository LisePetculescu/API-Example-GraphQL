          }
        }
      ]
    },
    {
      "name": "Negative - Query non-existing character",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query {\\n  character(id: 999999) {\\n    id\\n    name\\n  }\\n}\",\n  \"variables\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 because GraphQL returns errors in body\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"GraphQL errors exist\", function () {",
              "  pm.expect(json.errors).to.be.an(\"array\");",
              "});",
              "pm.test(\"Error message mentions not found\", function () {",
              "  pm.expect(JSON.stringify(json.errors)).to.include(\"Character not found\");",
              "});"
            ]
          }
        }
      ]
    },
