    {
      "name": "Security - SQL injection-like search should not break API",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"query {\\n  characters(search: \\\"' OR 1=1 --\\\", page: 1, limit: 10) {\\n    id\\n    name\\n    race\\n  }\\n}\",\n  \"variables\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"No internal SQL/database error leaked\", function () {",
              "  pm.expect(JSON.stringify(json)).to.not.include(\"syntax error\");",
              "  pm.expect(JSON.stringify(json)).to.not.include(\"SQL\");",
              "  pm.expect(JSON.stringify(json)).to.not.include(\"PrismaClient\");",
              "});",
              "pm.test(\"characters result exists or safe GraphQL error is returned\", function () {",
              "  pm.expect(json.data || json.errors).to.exist;",
              "});"
            ]
          }
        }
      ]
    }
