          "raw": "{\n  \"query\": \"mutation DeleteCharacter($id: ID!) {\\n  deleteCharacter(id: $id)\\n}\",\n  \"variables\": {\n    \"id\": \"{{createdCharacterId}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
