        ],
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation UpdateCharacter($id: ID!, $input: CharacterInput!) {\n  updateCharacter(id: $id, input: $input) {\n    id\n    name\n    race\n    weapon\n  }\n}",
            "variables": "{\n  \"id\": \"{{createdCharacterId}}\",\n  \"input\": {\n    \"name\": \"Boromir\",\n    \"race\": \"Man\",\n    \"realm\": \"Gondor\",\n    \"birthYear\": \"2978 Third Age\",\n    \"weapon\": \"Horn of Gondor\",\n    \"affiliation\": \"Fellowship of the Ring\",\n    \"shortDescription\": \"A warrior of Gondor and member of the Fellowship.\",\n    \"biography\": \"Boromir was the eldest son of Denethor II and travelled with the Fellowship.\",\n    \"imageUrl\": \"https://example.com/boromir.jpg\"\n  }\n}"
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () { pm.expect(json.errors).to.be.undefined; });",
              "pm.test(\"weapon was updated\", function () { pm.expect(json.data.updateCharacter.weapon).to.eql(\"Horn of Gondor\"); });"
            ]
          }
        }
      ]
    },
    {
