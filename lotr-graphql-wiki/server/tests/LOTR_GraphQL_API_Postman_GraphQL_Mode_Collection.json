    {
      "name": "Security - XSS-like input should be rejected or sanitized",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation CreateCharacter($input: CharacterInput!) {\n  createCharacter(input: $input) {\n    id\n    name\n    biography\n  }\n}",
            "variables": "{\n  \"input\": {\n    \"name\": \"<script>alert('xss')</script>\",\n    \"race\": \"Elf\",\n    \"shortDescription\": \"XSS test input.\",\n    \"biography\": \"<img src=x onerror=alert('xss')>\",\n    \"imageUrl\": \"https://example.com/test.jpg\"\n  }\n}"
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200 or 400\", function () { pm.expect([200, 400]).to.include(pm.response.code); });",
              "const json = pm.response.json();",
              "pm.test(\"XSS is not accepted as executable raw HTML\", function () {",
              "  if (json.errors) {",
              "    pm.expect(json.errors).to.be.an(\"array\").that.is.not.empty;",
              "  } else {",
              "    const created = json.data.createCharacter;",
              "    pm.expect(created.name).to.not.include(\"<script>\");",
              "    pm.expect(created.biography).to.not.include(\"<img\");",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Security - SQL injection-like search should not break API",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query SearchCharacters($search: String) {\n  characters(search: $search, page: 1, limit: 10) {\n    id\n    name\n  }\n}",
            "variables": "{\"search\": \"' OR 1=1 --\"}"
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test(\"No internal SQL/database error leaked\", function () {",
              "  const body = pm.response.text().toLowerCase();",
              "  pm.expect(body).to.not.include(\"syntax error\");",
              "  pm.expect(body).to.not.include(\"prisma\");",
              "  pm.expect(body).to.not.include(\"postgres\");",
              "});",
              "pm.test(\"Response shape is valid GraphQL\", function () { pm.expect(json.data.characters).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    }
