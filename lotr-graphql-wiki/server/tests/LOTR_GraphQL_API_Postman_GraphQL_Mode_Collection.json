{
  "info": {
    "_postman_id": "c457f09e-a3f3-4ce0-9179-1ed1c1b640a5",
    "name": "LOTR GraphQL API - GraphQL Mode Tests",
    "description": "GraphQL-mode Postman collection for LOTR GraphQL API. Includes positive, negative, and security-oriented requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "createdCharacterId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Positive - Query all characters",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetCharacters($page: Int, $limit: Int) {\n  characters(page: $page, limit: $limit) {\n    id\n    name\n    race\n    realm\n    shortDescription\n  }\n}",
            "variables": "{\"page\": 1, \"limit\": 10}"
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () { pm.expect(json.errors).to.be.undefined; });",
              "pm.test(\"characters is an array\", function () { pm.expect(json.data.characters).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Positive - Query character by ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query GetCharacter($id: ID!) {\n  character(id: $id) {\n    id\n    name\n    race\n    biography\n    quotes {\n      id\n      text\n    }\n  }\n}",
            "variables": "{\"id\": \"1\"}"
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () { pm.expect(json.errors).to.be.undefined; });",
              "pm.test(\"character has expected fields\", function () { pm.expect(json.data.character).to.have.property(\"name\"); pm.expect(json.data.character.quotes).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Positive - Create character",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
