        ],
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "graphql"
          ]
        },
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation CreateCharacter($input: CharacterInput!) {\n  createCharacter(input: $input) {\n    id\n    name\n    race\n    shortDescription\n  }\n}",
            "variables": "{\n  \"input\": {\n    \"name\": \"Boromir\",\n    \"race\": \"Man\",\n    \"realm\": \"Gondor\",\n    \"birthYear\": \"2978 Third Age\",\n    \"weapon\": \"Sword and shield\",\n    \"affiliation\": \"Fellowship of the Ring\",\n    \"shortDescription\": \"A warrior of Gondor and member of the Fellowship.\",\n    \"biography\": \"Boromir was the eldest son of Denethor II and travelled with the Fellowship.\",\n    \"imageUrl\": \"https://example.com/boromir.jpg\"\n  }\n}"
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test(\"No GraphQL errors\", function () { pm.expect(json.errors).to.be.undefined; });",
              "pm.test(\"created character has id\", function () { pm.expect(json.data.createCharacter.id).to.exist; });",
              "pm.collectionVariables.set(\"createdCharacterId\", json.data.createCharacter.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Positive - Update created character",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Apollo-Require-Preflight",
            "value": "true"
